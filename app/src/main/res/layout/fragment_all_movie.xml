<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rvMoviesmovie"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.allMovieFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMoviesmovieFragment"
        android:layout_width="401dp"
        android:layout_height="666dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnFavorites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="66dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:backgroundTint="#CCCCCC"
        android:text="Favorites"
        app:layout_constraintBottom_toTopOf="@+id/rvMoviesmovieFragment"
        app:layout_constraintEnd_toStartOf="@+id/btnWatchlist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnWatchlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="66dp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:backgroundTint="#CCCCCC"
        android:text="Watchlist"
        app:layout_constraintBottom_toTopOf="@+id/rvMoviesmovieFragment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnFavorites"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnaddNmovie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="48dp"
        android:backgroundTint="#CCCCCC"
        android:text="+ NEW MOVIE"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
